{
  "name": "clue",
  "version": "0.3.0",
  "description": "A coding agent for the terminal that uses Claude's API natively",
  "private": true,
  "type": "module",
  "bin": {
    "clue": "./src/main.ts"
  },
  "scripts": {
    "dev": "bun src/main.ts",
    "build": "bun scripts/build.ts",
    "bench": "bun benchmarks/run.ts",
    "bench:check": "bun run build && bun benchmarks/run.ts --check",
    "bench:tools": "bun benchmarks/tools.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^6"
  }
}
