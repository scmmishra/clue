---
import timelessSans from '../fonts/timeless/TimelessSansVF.woff2?url';
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import { ogImageFor } from '../og/pages';
import { HEIGHT, WIDTH } from '../og/size';
import { SITE_NAME } from '../site';
import '../styles/global.css';

type Props = {
	title: string;
	description: string;
	// `article` for docs pages. Everything else is a `website`.
	type?: 'website' | 'article';
	// Keeps the page out of search results, such as the 404 page.
	noindex?: boolean;
	// Structured data for search engines, written as JSON-LD.
	schema?: Record<string, unknown>;
	// When an article last changed, in ISO 8601.
	modified?: string;
};

const { title, description, type = 'website', noindex = false, schema, modified } = Astro.props;
const repo = 'https://github.com/scmmishra/clue';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const image = new URL(ogImageFor(path), Astro.site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0b0b0b" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(WIDTH)} />
		<meta property="og:image:height" content={String(HEIGHT)} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content="en_US" />
		{modified && <meta property="article:modified_time" content={modified} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<link rel="preload" href={timelessSans} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
		{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
	</head>
	<body>
		<div class="page">
			<header class="top">
				<a class="name" href="/"><img src="/favicon.svg" width="24" height="24" alt="" />clue</a>
				<nav aria-label="Main">
					<a href="/docs">docs</a>
					<a href="/changelog">changelog</a>
					<a href={repo}>source</a>
				</nav>
			</header>

			<slot />

			<footer class="foot">
				<p>Apache-2.0</p>
				<p>Builds on <a href="https://pi.dev">pi</a> and <a href="https://github.com/vercel-labs/fx">fx</a>.</p>
			</footer>
		</div>

		<slot name="scripts" />
	</body>
</html>
