---
import { markdownPath } from '../../docs/markdown';
import { NAV } from '../../docs/nav';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
	const files = import.meta.glob('../../docs/*.md', { eager: true });
	return NAV.flatMap(({ pages }) => pages).map(({ title, slug }) => ({
		params: { slug: slug || undefined },
		props: { title, file: files[`../../docs/${slug || 'quick-start'}.md`] },
	}));
}

const { title, file } = Astro.props;
const { Content } = file;
const current = Astro.params.slug ?? '';
---

<Base title={`${title}, clue docs`} description={`${title} in the clue docs.`}>
	<main class="docs">
		<nav class="docs-nav" aria-label="Docs">
			{
				NAV.map(({ group, pages }) => (
					<div>
						<p>{group}</p>
						{pages.map(({ title, slug }) => (
							<a href={slug ? `/docs/${slug}` : '/docs'} aria-current={slug === current ? 'page' : undefined}>
								{title}
							</a>
						))}
					</div>
				))
			}
		</nav>
		<article class="prose">
			<div class="docs-title">
				<h1>{title}</h1>
				<button type="button" data-markdown-link={markdownPath(current)}>copy markdown link</button>
			</div>
			<Content />
		</article>
	</main>
	<script slot="scripts">
		const COPIED_MS = 1500;
		const button = document.querySelector('[data-markdown-link]');
		const label = button.textContent;
		let reset = 0;

		button.addEventListener('click', async () => {
			const link = new URL(button.dataset.markdownLink, location.origin).href;
			try {
				await navigator.clipboard.writeText(link);
				button.textContent = 'copied';
			} catch {
				// The browser refused, so show the Markdown instead.
				location.href = link;
				return;
			}
			clearTimeout(reset);
			reset = window.setTimeout(() => (button.textContent = label), COPIED_MS);
		});
	</script>
</Base>
